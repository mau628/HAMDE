{
  "name": "yamde",
  "version": "0.0.0",
  "private": true,
  "description": "Local-first Markdown editor with Obsidian-style live preview. Runs entirely in the browser.",
  "type": "module",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "generate": "nuxt generate && node scripts/apply-csp-hashes.mjs",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run generate && playwright test",
    "check:offline": "node scripts/check-no-remote-urls.mjs",
    "verify": "npm run typecheck && npm run test && npm run generate && npm run check:offline",
    "serve:static": "node scripts/serve-static.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@vitest/coverage-v8": "4.1.11",
    "nuxt": "4.5.2",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "vue": "3.5.42",
    "vue-tsc": "3.3.11"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.5",
    "@codemirror/view": "6.43.12",
    "@lezer/common": "1.5.2",
    "@lezer/highlight": "1.2.3",
    "@lezer/markdown": "1.7.2"
  }
}
